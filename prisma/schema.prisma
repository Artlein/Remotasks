datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id        String   @id @default(uuid())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
}

model Task {
  id              String   @id @default(uuid())
  date            String   // YYYY-MM-DD logical work date
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description     String
  durationMinutes Int
  status          String   @default("Done") // Done, Review, Pending
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
  @@index([projectId])
}

model SystemSettings {
  id                 String   @id @default("default")
  logicalCutoffHour  Int      @default(0) // Default 0 (12:00 AM midnight reset)
  dailyTargetHours   Float    @default(8.0)
  hourlyRate         Float    @default(0.0) // Optional hourly rate for earnings estimation
  updatedAt          DateTime @updatedAt
}
